{
  "name": "RelayX",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun --filter @app/web dev",
    "dev:server": "bun --filter @app/server dev",
    "dev:ws": "bun --filter @app/ws dev",
    "db:generate": "bun --filter @repo/database db:generate",
    "db:migrate": "bun --filter @repo/database db:migrate",
    "db:push": "bun --filter @repo/database db:push",
    "db:studio": "bun --filter @repo/database db:studio"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "paralleldrive/cuid2",
    "typescript": "^5.0.0"
  }
}
